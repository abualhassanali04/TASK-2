@HostAddress = http://localhost:5212
@Token =Bearer {{login.response.body.$.accessToken}}
@RefreshToken = {{login.response.body.$.refreshToken}} 
### Categories - Get all
GET {{HostAddress}}/api/Categories


### Categories - Get by id
GET {{HostAddress}}/api/Categories/6

### Categories - Get products by category id
GET {{HostAddress}}/api/Categories/6/products

### Categories - Create
POST {{HostAddress}}/api/Categories
Content-Type: application/json

{
  "name": "Books",
  "description": "Books and reading materials"
}

### Categories - Update
PUT {{HostAddress}}/api/Categories/7
Content-Type: application/json

{
  "name": "Books Updated",
  "description": "Updated books and reading materials"
}

### Categories - Delete
DELETE {{HostAddress}}/api/Categories/8


### Products - Get all
GET {{HostAddress}}/api/Products

### Products - Get all with pagination
GET {{HostAddress}}/api/Products?page=1&pageSize=5

### Products - Search by name
GET {{HostAddress}}/api/Products?search=n

### Products - Search by price range
GET {{HostAddress}}/api/Products?minprice=1300

### Products - Search by category id
GET {{HostAddress}}/api/Products?categoryid=7

### Products - Get by id
GET {{HostAddress}}/api/Products/3

### Products - Create
POST {{HostAddress}}/api/Products
Content-Type: application/json
Authorization:{{Token}}

{
  "name": "Phone:poco f9 Ultra",
  "price": 799.99,
  "stock": 45,
  "categoryId": 6
}
### test error
GET {{HostAddress}}/api/Products/test-error

### Products - Update
PUT {{HostAddress}}/api/Products/12
Content-Type: application/json
Authorization:{{Token}}

{
  "name": "Phone: Hawaii P50 Pro",
  "price": 299.99,
  "stock": 15,
  "categoryId": 6
}


### Products - Delete
DELETE {{HostAddress}}/api/Products/13
Authorization:{{Token}}



### Reports - Inventory value
GET {{HostAddress}}/api/reports/inventory-value
Authorization: {{Token}}
### Reports - Most expensive product
GET {{HostAddress}}/api/reports/most-expensive-product
Authorization: {{Token}}

### Reports - Out of stock products
GET {{HostAddress}}/api/reports/out-of-stock
Authorization:{{Token}}


### Auth - Register a new user
POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "Admin",
  "password": "Admin123"
  }

### Auth - Login with Admin role
# @name login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "Admin",
  "password": "Admin123"
}

### Auth - Login with User role
# @name login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "Alihussein",
  "password": "Testing123"
}

### Auth - Login with nonexistent username
# @name login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "nonexistent",
  "password": "AnyPassword"
}

### Auth - Refresh token
# @name login
POST {{HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken":"{{RefreshToken}}"
}


### test error
GET {{HostAddress}}/api/Products/test-error

