# Copy to .env (the Codespace does this automatically). .env is git-ignored — never commit it.
# sa password rules: 8+ chars, upper + lower case, a digit, a symbol.
MSSQL_SA_PASSWORD=Change_Me_123!

# Overrides appsettings.json's LocalDB string when running inside the Codespace:
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=ProductCatalogDb;User Id=sa;Password=Change_Me_123!;TrustServerCertificate=True"

# JWT settings (use a random value of at least 32 characters: openssl rand -base64 48)
Jwt__Key="replace-with-a-random-secret-at-least-32-chars"
Jwt__Issuer="ProductCatalogApi"
Jwt__Audience="ProductCatalogApi"
